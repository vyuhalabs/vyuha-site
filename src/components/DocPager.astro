---
// Previous and next page, in the reading order of `pages` in src/lib/site.ts.
import { href, isCurrent, pages } from "../lib/site";

const i = pages.findIndex((p) => isCurrent(Astro.url.pathname, p.path));
const prev = i > 0 ? pages[i - 1] : undefined;
const next = i >= 0 && i < pages.length - 1 ? pages[i + 1] : undefined;
---

{
  (prev || next) && (
    <nav class="pager" aria-label="Previous and next page">
      {prev && (
        <a class="pager__link" href={href(prev.path)} rel="prev">
          <span class="pager__dir">Previous</span>
          <span class="pager__label">{prev.label}</span>
        </a>
      )}
      {next && (
        <a class="pager__link pager__link--next" href={href(next.path)} rel="next">
          <span class="pager__dir">Next</span>
          <span class="pager__label">{next.label}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-16);
  }
  .pager__link {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    text-decoration: none;
  }
  .pager__link:hover {
    border-color: var(--color-border-strong);
  }
  .pager__link--next {
    grid-column: 2;
    text-align: right;
  }
  .pager__dir {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .pager__label {
    font-weight: 600;
    font-size: var(--text-lg);
  }
  .pager__link:hover .pager__label {
    color: var(--color-accent);
  }
</style>

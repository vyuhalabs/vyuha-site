---
import { site } from "../lib/site";
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>{site.name}: a formation of agents that moves as one.</p>
    <ul class="footer-links">
      <li><a href={site.repository}>Source on GitHub</a></li>
      <li><a href={site.accessRequestUrl}>Ask for access</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }
  .site-footer p {
    margin: 0;
  }
  .footer-links {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-links a {
    color: var(--color-text-muted);
  }
</style>

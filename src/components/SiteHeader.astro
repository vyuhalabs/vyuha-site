---
import { href, site } from "../lib/site";
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href={href("/")}>{site.name}<span class="visually-hidden">, home</span></a>
    <nav aria-label="Main">
      <ul class="nav-list">
        <li><a href={href(site.guidePath)}>Getting started</a></li>
        <li><a href={site.accessRequestUrl}>Ask for access</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 4rem;
  }
  .wordmark {
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
  }
  .nav-list {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-list a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 600;
  }
  .nav-list a:hover {
    color: var(--color-text);
  }
</style>

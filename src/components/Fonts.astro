---
// Self-hosted Source Sans 3 and JetBrains Mono (SIL OFL 1.1, from Fontsource),
// Latin subset only. Only the body text weight is preloaded; the rest load
// on first use. See docs/fonts.md.
import mono400 from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url";
import sans400i from "@fontsource/source-sans-3/files/source-sans-3-latin-400-italic.woff2?url";
import sans400 from "@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url";
import sans600 from "@fontsource/source-sans-3/files/source-sans-3-latin-600-normal.woff2?url";
import sans700 from "@fontsource/source-sans-3/files/source-sans-3-latin-700-normal.woff2?url";

const latin =
  "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";

const faces = [
  { family: "Source Sans 3", weight: 400, style: "normal", url: sans400 },
  { family: "Source Sans 3", weight: 400, style: "italic", url: sans400i },
  { family: "Source Sans 3", weight: 600, style: "normal", url: sans600 },
  { family: "Source Sans 3", weight: 700, style: "normal", url: sans700 },
  { family: "JetBrains Mono", weight: 400, style: "normal", url: mono400 },
];

const css = faces
  .map(
    (f) =>
      `@font-face{font-family:"${f.family}";font-style:${f.style};font-weight:${f.weight};font-display:swap;src:url(${f.url}) format("woff2");unicode-range:${latin}}`,
  )
  .join("");
---

<link rel="preload" href={sans400} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css} />

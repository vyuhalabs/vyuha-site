---
// The window every product illustration sits in: a title bar with a
// breadcrumb in mono, and the screen below. The whole frame is one image to
// assistive technology (role="img" with a label that says what it shows), so
// a screen reader hears one sentence, not a table of invented data.
export interface Props {
  /** What the illustration shows, read by screen readers. */
  label: string;
  /** Breadcrumb segments in the title bar, e.g. ["Web", "Customer portal"]. */
  crumbs: string[];
  class?: string;
}

const { label, crumbs, class: className } = Astro.props;
---

<div class:list={["frame", className]} role="img" aria-label={label}>
  <div class="frame__bar">
    <span class="frame__dots"><i></i><i></i><i></i></span>
    <span class="frame__crumbs">
      {
        crumbs.map((c, i) => (
          <>
            {i > 0 && <span class="frame__sep">/</span>}
            <span class:list={[{ "frame__crumb--last": i === crumbs.length - 1 }]}>{c}</span>
          </>
        ))
      }
    </span>
    <slot name="bar" />
  </div>
  <div class="frame__body">
    <slot />
  </div>
</div>

<style is:global>
  /*
   * Shared vocabulary of the illustrations. Colours only from the tokens; the
   * accent marks what the section is about, never decoration.
   */
  .frame {
    --ill-text-xs: 0.75rem;
    --ill-text-sm: 0.8125rem;
    --ill-tint: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
    container-type: inline-size;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow:
      0 1px 2px rgb(28 25 23 / 0.04),
      0 12px 32px -12px rgb(28 25 23 / 0.12);
    overflow: hidden;
    font-size: var(--ill-text-sm);
    line-height: 1.45;
    color: var(--color-text);
    min-width: 0;
  }
  @media (prefers-color-scheme: dark) {
    .frame {
      box-shadow:
        0 1px 0 rgb(255 255 255 / 0.03) inset,
        0 16px 40px -16px rgb(0 0 0 / 0.6);
    }
  }
  .frame__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.5rem;
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-subtle);
    font-family: var(--font-mono);
    font-size: var(--ill-text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .frame__dots {
    display: inline-flex;
    gap: 6px;
    flex: none;
  }
  .frame__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-border);
  }
  .frame__crumbs {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
  }
  .frame__sep {
    margin-inline: 0.5em;
    opacity: 0.6;
  }
  .frame__crumb--last {
    color: var(--color-text);
  }
  .frame__body {
    padding: var(--space-4);
  }
  @container (min-width: 34rem) {
    .frame__body {
      padding: var(--space-6);
    }
  }

  /* Pieces reused across illustrations. */
  .ill-mono {
    font-family: var(--font-mono);
    font-size: var(--ill-text-xs);
  }
  .ill-muted {
    color: var(--color-text-muted);
  }
  .ill-label {
    font-family: var(--font-mono);
    font-size: var(--ill-text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .ill-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.1em 0.6em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--ill-text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .ill-pill--accent {
    border-color: var(--color-accent);
    color: var(--color-text);
    background: var(--ill-tint);
  }
  .ill-dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-border-strong);
    flex: none;
  }
  .ill-dot--active {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }
  .ill-dot--done {
    border-color: var(--color-text-muted);
    background: var(--color-text-muted);
  }
  .ill-check {
    color: var(--color-accent);
    font-weight: 700;
  }
  .ill-truncate {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

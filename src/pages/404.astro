---
import BaseLayout from "../layouts/BaseLayout.astro";
import { href } from "../lib/site";
---

<BaseLayout title="Page not found" description="There is no page at this address." noindex>
  <section class="container page-section" aria-labelledby="page-title">
    <h1 id="page-title">Page not found</h1>
    <p class="lede">There is no page at this address. It may have moved.</p>
    <p><a class="button" href={href("/")}>Go to the home page</a></p>
  </section>
</BaseLayout>

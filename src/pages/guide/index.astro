---
// The getting-started guide (src/content/docs/guide.md). Access is by
// request, so the page says so first, with the link to the request template.
import { getEntry } from "astro:content";
import DocLayout from "../../layouts/DocLayout.astro";
import { sectionize } from "../../lib/sections.mjs";
import { site } from "../../lib/site";

const entry = await getEntry("docs", "guide");
if (!entry) throw new Error("src/content/docs/guide.md is missing");
if (!entry.rendered?.html) throw new Error("docs entry has no rendered body");
const { html, sections } = sectionize(entry.rendered.html);
const { title, description, eyebrow, lede, ogImage, numbered } = entry.data;
---

<DocLayout {...{ title, description, eyebrow, lede, ogImage, numbered }} toc={sections}>
  <div slot="intro" class="notice">
    <p>
      <strong>Access is by request.</strong> This guide starts once you have it. To ask, open an issue on GitHub from the
      access request template.
    </p>
    <a class="button" href={site.accessRequestUrl}>Ask for access<span class="visually-hidden"> (opens an issue on GitHub)</span></a>
  </div>
  <Fragment set:html={html} />
</DocLayout>

<style>
  .notice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    max-width: var(--prose-width);
    margin-top: var(--space-8);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .notice p {
    flex: 1 1 20rem;
    margin: 0;
    color: var(--color-text-muted);
  }
  .notice strong {
    color: var(--color-text);
  }
</style>
